; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Hell Jump"
config/description="A hellish platformer"
config/version="1.1.2"
config/tags=PackedStringArray("first_game")
run/main_scene="uid://b6kdoxch4ks0t"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://8lycgb0u1t7k"

[audio]

buses/default_bus_layout="uid://qxjdoie6q02j"

[autoload]

SaveManager="*uid://5vpcxgmta44g"
SettingsManager="*uid://d2qhmsud3bldg"
LoadingManager="*uid://f5g22ntkqvg2"
MiscManager="*uid://w1gesuay1wtq"
AchievementManager="*uid://02cr0d27o1qy"
AdManager="*uid://ct1t3c436fmxw"

[display]

window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="x11"

[editor]

movie_writer/movie_file="/home/aramcz/Documents/My games/hell-jump/clip.avi"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg", "res://addons/SimpleAchievement/plugin.cfg", "res://addons/releasehook/plugin.cfg")

[file_customization]

folder_colors={
"res://Music/": "green",
"res://Photos/": "red",
"res://SFX/": "blue",
"res://Scenes/": "purple",
"res://Scripts/": "yellow",
"res://misc/": "gray"
}

